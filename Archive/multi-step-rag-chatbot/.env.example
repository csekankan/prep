# Copy to .env and fill in values.
# Without OPENAI_API_KEY the app runs in MOCK mode (retrieval still works; answers are templated).

OPENAI_API_KEY=

# Chat model (needs API key). Use a small/cheap model for learning.
CHAT_MODEL=gpt-4o-mini

# Embeddings: "local" uses Sentence-Transformers on CPU (no API key).
# Set to "openai" to use text-embedding-3-small (needs OPENAI_API_KEY).
EMBEDDING_PROVIDER=local

# Where Chroma persists vectors (created automatically on first ingest).
CHROMA_PERSIST_DIR=./data/chroma

# Collection name inside Chroma (one logical "knowledge base").
CHROMA_COLLECTION=acme_knowledge

# Log level: DEBUG shows retrieval scores and routing decisions.
LOG_LEVEL=INFO
